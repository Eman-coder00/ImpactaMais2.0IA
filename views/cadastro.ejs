<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/head', { title: 'Cadastro' }) %>
<body>

    <a href="/" class="back-home">
        <i data-lucide="arrow-left" aria-hidden="true"></i> Voltar para o início
    </a>

    <main class="auth-page">
        <div class="auth-card">
            <div class="auth-header">
                <a href="/" class="logo" style="display: block; margin-bottom: 1.5rem;"><span>Impacta</span>Mais</a>
                <h1>Criar uma conta</h1>
                <p>Junte-se ao nosso hub e comece a transformar realidades.</p>
            </div>

            <% if (error) { %>
                <div class="alert alert-error" role="alert" style="background: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.9rem; text-align: center;">
                    <%= error %>
                </div>
            <% } %>

            <form class="auth-form" id="cadastroForm" method="POST" action="/cadastro">
                <div class="form-group">
                    <label for="name">
                        Nome 
                        <span aria-label="Campo obrigatório" class="required" style="color: #ef4444;">*</span>
                    </label>
                    <input type="text" id="name" name="name" placeholder="Digite seu nome" required>
                </div>

                <div class="form-group">
                    <label for="email">
                        E-mail 
                        <span aria-label="Campo obrigatório" class="required" style="color: #ef4444;">*</span>
                    </label>
                    <input type="email" id="email" name="email" placeholder="Digite seu E-mail" required>
                </div>

                <div class="form-group">
                    <label for="password">
                        Senha 
                        <span aria-label="Campo obrigatório" class="required" style="color: #ef4444;">*</span>
                    </label>
                    <input type="password" id="password" name="password" placeholder="Digite sua senha" required>
                </div>

                <div class="form-group">
                    <label for="confirm-password">
                        Confirmar senha 
                        <span aria-label="Campo obrigatório" class="required" style="color: #ef4444;">*</span>
                    </label>
                    <input type="password" id="confirm-password" name="confirmPassword" placeholder="Confirma sua senha" required>
                </div>

                <label class="form-checkbox" for="terms-check">
                    <input type="checkbox" name="terms" id="terms-check" required>
                    <span>Li e concordo com os termos de <a href="/politica-privacidade" style="color: var(--emerald-600); font-weight: 600; text-decoration: underline;">Política de privacidade</a>.</span>
                </label>

                <button type="submit" class="btn btn-primary">Criar conta</button>
            </form>

            <div class="auth-footer">
                Voltar para <a href="/login">Login</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
