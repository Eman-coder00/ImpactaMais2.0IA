<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/head', { title: event.title }) %>
<body>
    <%- include('partials/navbar') %>

    <section class="section-padding" style="padding-top: 120px;">
        <div class="container">
            <div class="project-header animate-up">
                <span class="project-tag"><%= event.category %></span>
                <h1><%= event.title %></h1>
                <p class="lead-text"><%= event.description %></p>
            </div>

            <div class="project-details-grid">
                <div class="main-content animate-up">
                    <h2>Sobre este Evento</h2>
                    <p style="white-space: pre-line;"><%= event.longDescription %></p>
                    
                    <div class="author-info" style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--gray-100); display: flex; align-items: center; gap: 1rem;">
                        <div class="author-avatar" style="width: 50px; height: 50px; border-radius: 50%; overflow: hidden; background: var(--emerald-500); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1.2rem;">
                            <% if (locals.author && author.profilePic) { %>
                                <img src="<%= author.profilePic %>" alt="<%= event.authorName %>" style="width: 100%; height: 100%; object-fit: cover;">
                            <% } else { %>
                                <%= event.authorName ? event.authorName.charAt(0).toUpperCase() : '?' %>
                            <% } %>
                        </div>
                        <div>
                            <span style="display: block; font-size: 0.85rem; color: var(--gray-600);">Organizado por</span>
                            <strong style="color: var(--navy-900);"><%= event.authorName %></strong>
                        </div>
                    </div>

                    <div class="project-actions" style="margin-top: 2rem;">
                        <% if (locals.hasPassed) { %>
                            <div class="alert" style="background: var(--gray-100); color: var(--gray-600); border: 1px solid var(--gray-200); padding: 1.5rem; border-radius: 12px; text-align: center; font-weight: 600;">
                                <i data-lucide="clock" style="vertical-align: middle; margin-right: 0.5rem;"></i> Este evento já foi realizado e as inscrições estão encerradas.
                            </div>
                        <% } else { %>
                            <% if (user) { %>
                                <% if (event.authorId.toString() !== user._id.toString()) { %>
                                    <% if (locals.isParticipating) { %>
                                        <div style="display: flex; flex-direction: column; gap: 1rem;">
                                            <div class="alert" style="background: #ecfdf5; color: #065f46; border: 1px solid #10b981; padding: 1.5rem; border-radius: 12px; text-align: center; font-weight: 600;">
                                                <i data-lucide="check-circle" style="vertical-align: middle; margin-right: 0.5rem;"></i> Você está inscrito neste evento!
                                            </div>

                                            <% if (locals.googleCalendarUrl) { %>
                                                <div style="background: var(--gray-50); padding: 1.5rem; border-radius: 16px; border: 1px solid var(--gray-200); margin-top: 0.5rem;">
                                                    <h4 style="font-size: 0.9rem; color: var(--navy-900); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                                                        <i data-lucide="calendar" style="width: 18px; height: 18px;"></i>
                                                        Salvar na minha Agenda
                                                    </h4>
                                                    <div style="display: grid; grid-template-columns: 1fr; gap: 0.75rem;">
                                                        <a href="<%= googleCalendarUrl %>" target="_blank" class="btn-calendar" style="display: flex; align-items: center; gap: 0.75rem; background: white; border: 1px solid #e5e7eb; padding: 0.75rem 1rem; border-radius: 10px; color: #374151; font-size: 0.9rem; text-decoration: none; transition: all 0.2s;">
                                                            <img src="https://www.google.com/favicon.ico" alt="Google" style="width: 18px; height: 18px;">
                                                            Google Agenda
                                                        </a>
                                                        <a href="<%= outlookCalendarUrl %>" target="_blank" class="btn-calendar" style="display: flex; align-items: center; gap: 0.75rem; background: white; border: 1px solid #e5e7eb; padding: 0.75rem 1rem; border-radius: 10px; color: #374151; font-size: 0.9rem; text-decoration: none; transition: all 0.2s;">
                                                            <img src="https://outlook.live.com/favicon.ico" alt="Outlook" style="width: 18px; height: 18px;">
                                                            Outlook / Office 365
                                                        </a>
                                                        <a href="/evento/agenda/<%= event._id %>/ics" class="btn-calendar" style="display: flex; align-items: center; gap: 0.75rem; background: white; border: 1px solid #e5e7eb; padding: 0.75rem 1rem; border-radius: 10px; color: #374151; font-size: 0.9rem; text-decoration: none; transition: all 0.2s;">
                                                            <i data-lucide="download" style="width: 18px; height: 18px; color: var(--navy-900);"></i>
                                                            Apple / Outros (.ics)
                                                        </a>
                                                    </div>
                                                </div>

                                                <style>
                                                    .btn-calendar:hover {
                                                        border-color: var(--navy-900) !important;
                                                        background-color: var(--navy-50) !important;
                                                        transform: translateY(-2px);
                                                        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
                                                    }
                                                </style>
                                            <% } %>


                                            <form action="/evento/cancelar" method="POST">
                                                <input type="hidden" name="eventId" value="<%= event._id %>">
                                                <button type="submit" class="btn btn-outline" style="width: 100%; border-color: #ef4444; color: #ef4444;">Sair do Evento</button>
                                            </form>
                                        </div>
                                    <% } else { %>
                                        <form action="/evento/inscrever" method="POST">
                                            <input type="hidden" name="eventId" value="<%= event._id %>">
                                            <p style="font-size: 0.85rem; color: var(--gray-600); margin-bottom: 0.75rem; text-align: center; line-height: 1.4;">
                                                Ao se inscrever, você autoriza o compartilhamento do seu e-mail com o organizador do evento para fins de contato.
                                            </p>
                                            <button type="submit" class="btn btn-primary" style="width: 100%; height: 60px; font-size: 1.2rem;">Participar deste Evento</button>
                                        </form>
                                    <% } %>
                                <% } %>
                            <% } else { %>
                                <a href="/login" class="btn btn-primary" style="width: 100%; height: 60px; font-size: 1.2rem;">Faça login para participar</a>
                            <% } %>
                        <% } %>
                    </div>

                    <% if (user && event.authorId.toString() === user._id.toString()) { %>
                        <div class="organizer-actions" style="margin-top: 2rem; padding: 1.5rem; background: var(--gray-50); border-radius: 16px; border: 1px dashed var(--gray-300);">
                            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                                <div style="width: 40px; height: 40px; background: var(--navy-900); color: white; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                    <i data-lucide="settings" style="width: 20px; height: 20px;"></i>
                                </div>
                                <div>
                                    <h4 style="margin: 0; font-size: 1rem; color: var(--navy-900);">Área do Organizador</h4>
                                    <p style="margin: 0; font-size: 0.8rem; color: var(--gray-500);">Gerencie os participantes do seu evento</p>
                                </div>
                            </div>
                            <a href="/evento/exportar/<%= event._id %>" class="btn btn-outline" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; background: white; border-color: var(--gray-200); color: var(--navy-900); font-weight: 600; padding: 0.8rem;">
                                <i data-lucide="download" style="width: 18px; height: 18px;"></i>
                                Baixar Lista de Participantes (CSV)
                            </a>
                        </div>
                    <% } %>
                </div>

                <aside class="sidebar animate-up">
                    <div class="sidebar-card">
                        <h3>Informações</h3>
                        <div class="stat-item">
                            <i data-lucide="calendar" class="stat-icon"></i>
                            <div>
                                <span class="stat-label">Data</span>
                                <p class="stat-value"><%= event.date %></p>
                            </div>
                        </div>
                        <div class="stat-item">
                            <i data-lucide="clock" class="stat-icon"></i>
                            <div>
                                <span class="stat-label">Horário</span>
                                <p class="stat-value"><%= event.time %></p>
                            </div>
                        </div>
                        <div class="stat-item">
                            <i data-lucide="map-pin" class="stat-icon"></i>
                            <div>
                                <span class="stat-label">Local</span>
                                <p class="stat-value"><%= event.location %></p>
                            </div>
                        </div>
                        <div class="stat-item" style="border-top: 1px solid var(--gray-100); padding-top: 1.5rem; margin-top: 1.5rem;">
                            <i data-lucide="users" class="stat-icon" style="color: var(--emerald-600);"></i>
                            <div>
                                <span class="stat-label">Confirmados</span>
                                <p class="stat-value" style="font-size: 1.5rem; color: var(--emerald-600);"><%= participantsCount %> <%= participantsCount === 1 ? 'pessoa' : 'pessoas' %></p>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </section>

    <%- include('partials/footer') %>
</body>
</html>
