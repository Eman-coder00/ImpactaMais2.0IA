        <!-- Premium Script -->
        <script src="/js/premium.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Inicializar ícones do Lucide imediatamente
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }

                // Função GLOBAL para abrir/fechar notificações
                window.toggleNotifications = function(e) {
                    if (e) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                    const d = document.getElementById('notifications-dropdown');
                    if (!d) return;

                    if (d.style.display === 'block') {
                        d.style.display = 'none';
                        d.hidden = true;
                    } else {
                        d.style.display = 'block';
                        d.hidden = false;
                        
                        // Ajuste para janelinha apenas no celular
                        if (window.innerWidth <= 768) {
                            d.style.position = 'fixed';
                            d.style.top = '50%';
                            d.style.left = '50%';
                            d.style.transform = 'translate(-50%, -50%)';
                            d.style.width = '90%';
                            d.style.maxWidth = '350px';
                            d.style.zIndex = '10005';
                            d.style.boxShadow = '0 0 0 100vmax rgba(0,0,0,0.5), 0 10px 25px rgba(0,0,0,0.2)'; // Fundo escurecido e sombra
                            d.style.borderRadius = 'var(--radius-lg)';
                            d.style.border = '2px solid var(--emerald-500)';
                            d.style.background = 'var(--white)';
                        } else {
                            // Reset para PC com cálculo dinâmico para posicionar sob o botão
                            const btnDesktop = document.getElementById('btn-notifications');
                            if (btnDesktop) {
                                const rect = btnDesktop.getBoundingClientRect();
                                d.style.position = 'fixed';
                                d.style.top = (rect.bottom + 10) + 'px';
                                d.style.right = (window.innerWidth - rect.right) + 'px';
                                d.style.left = 'auto';
                                d.style.transform = 'none';
                                d.style.width = '350px';
                                d.style.zIndex = '1000';
                                d.style.boxShadow = 'var(--shadow-lg)';
                                d.style.borderRadius = 'var(--radius-md)';
                            }
                        }

                        // Remove badges (bolinhas vermelhas) visualmente ao abrir
                        document.querySelectorAll('.notification-badge, .notification-dot').forEach(b => b.style.display = 'none');
                        
                        // Envia request silenciosa para marcar como lidas no banco
                        fetch('/notificacoes/ler', { method: 'POST' }).catch(err => console.error('[NOTIF] Erro automático:', err));
                    }
                };

                const btnNotif = document.getElementById('btn-notifications');

                const btnNotifNavbarMobile = document.getElementById('btn-notifications-navbar-mobile');

                // Registro dos cliques nos botões
                if (btnNotif) btnNotif.addEventListener('click', window.toggleNotifications);

                if (btnNotifNavbarMobile) btnNotifNavbarMobile.addEventListener('click', window.toggleNotifications);

                // Mobile Menu Toggle
                const mobileMenuToggle = document.getElementById('mobileMenuToggle');
                const navLinks = document.querySelector('.nav-links');

                if (mobileMenuToggle) {
                    mobileMenuToggle.addEventListener('click', () => {
                        navLinks.classList.toggle('active');
                        document.body.style.overflow = navLinks.classList.contains('active') ? 'hidden' : '';
                        const icon = mobileMenuToggle.querySelector('i');
                        if (navLinks.classList.contains('active')) {
                            icon.setAttribute('data-lucide', 'x');
                        } else {
                            icon.setAttribute('data-lucide', 'menu');
                        }
                        lucide.createIcons();
                    });
                }

                // Fechar ao clicar fora
                document.addEventListener('click', (e) => {
                    const d = document.getElementById('notifications-dropdown');
                    if (d && !d.hidden) {
                        const clickedOnBtn = e.target.closest('#btn-notifications') || 

                                           e.target.closest('#btn-notifications-navbar-mobile');
                        
                        if (!d.contains(e.target) && !clickedOnBtn) {
                            d.hidden = true;
                            d.style.display = 'none'; // Importante para zerar o estado visual
                        }
                    }
                });

                // Lógica de marcar como lidas
                if (btnMarkRead) {
                    btnMarkRead.addEventListener('click', async () => {
                        try {
                            await fetch('/notificacoes/ler', { method: 'POST' });
                            location.reload();
                        } catch (err) { console.error('[NOTIF] Erro ao marcar como lidas:', err); }
                    });
                }

            });
        </script>
    </div>
</nav>

