<!-- Central de Notificações Global (Modal Independente) -->
<% if (user) { %>
<div id="notifications-dropdown" class="search-dropdown" hidden style="background: var(--white); z-index: 10000;">
    <div style="padding: 1rem; border-bottom: 1px solid var(--gray-100); font-weight: 700; display: flex; justify-content: space-between; align-items: center;">
        Notificações
        <button id="btn-mark-read" style="background: none; border: none; font-size: 0.75rem; color: var(--emerald-600); cursor: pointer;">Marcar todas como lidas</button>
    </div>
    <div style="max-height: 350px; overflow-y: auto;">
        <% if (notifications.length > 0) { %>
            <% notifications.forEach(function(n) { %>
                <div class="notification-item <%= n.read ? '' : 'unread' %>" 
                     <% if (n.type === 'new_message') { %>
                        onclick="location.href='/mensagens/<%= n.fromId %>'"
                        style="cursor: pointer;"
                     <% } %>>
                    <p>
                        <% if (n.type === 'friend_request') { %>
                            <% 
                                const isPending = user.friendRequests && user.friendRequests.some(r => r.fromId.toString() === n.fromId.toString());
                                const isFriend = user.friends && user.friends.some(fId => fId.toString() === n.fromId.toString());
                            %>
                            <% if (isPending) { %>
                                <strong><%= n.fromName %></strong> enviou uma solicitação de amizade.
                            <% } else if (isFriend) { %>
                                Você aceitou o pedido de amizade de <strong><%= n.fromName %></strong>.
                            <% } else { %>
                                Você recusou o pedido de amizade de <strong><%= n.fromName %></strong>.
                            <% } %>
                        <% } else if (n.type === 'friend_request_accepted') { %>
                            Você aceitou o pedido de amizade de <strong><%= n.fromName %></strong>.
                        <% } else if (n.type === 'friend_request_declined') { %>
                            Você recusou o pedido de amizade de <strong><%= n.fromName %></strong>.
                        <% } else if (n.type === 'request_accepted') { %>
                            <strong><%= n.fromName %></strong> aceitou sua solicitação.
                        <% } else if (n.type === 'new_message') { %>
                            <strong><%= n.fromName %></strong>: "<%= n.content %>"
                        <% } %>
                    </p>
                    <% if (n.type === 'friend_request' && user.friendRequests && user.friendRequests.some(r => r.fromId.toString() === n.fromId.toString())) { %>
                        <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                            <form action="/amizade/respond" method="POST" style="margin: 0;">
                                <input type="hidden" name="fromId" value="<%= n.fromId %>">
                                <input type="hidden" name="action" value="accept">
                                <button type="submit" class="btn btn-primary" style="padding: 0.35rem 0.75rem; font-size: 0.75rem;">Aceitar</button>
                            </form>
                            <form action="/amizade/respond" method="POST" style="margin: 0;">
                                <input type="hidden" name="fromId" value="<%= n.fromId %>">
                                <input type="hidden" name="action" value="decline">
                                <button type="submit" class="btn btn-outline" style="padding: 0.35rem 0.75rem; font-size: 0.75rem;">Recusar</button>
                            </form>
                        </div>
                    <% } %>
                    <span class="notification-time"><%= new Date(n.date).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></span>
                </div>
            <% }); %>
        <% } else { %>
            <div style="padding: 2rem; text-align: center; color: var(--gray-400);">Nenhuma notificação por enquanto.</div>
        <% } %>
    </div>
</div>
<% } %>

<!-- Floating Search Button -->
<div class="floating-search-container">
    <div class="floating-search-bar" id="floatingSearchBar" style="display: none;">
        <i data-lucide="search" class="search-icon"></i>
        <input type="text" id="floatingSearchInput" placeholder="Buscar projeto/pessoa..." aria-label="Buscar projeto ou pessoa">
        <div id="floatingSearchResults" class="search-dropdown" hidden></div>
        <button id="btnCloseFloatingSearch" class="btn-close-floating" title="Fechar busca">
            <i data-lucide="x" style="width: 20px; height: 20px;"></i>
        </button>
    </div>
    <button class="btn-floating-search" id="btnOpenFloatingSearch" aria-label="Abrir busca">
        <i data-lucide="search" style="width: 28px; height: 28px;"></i>
    </button>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btnOpen = document.getElementById('btnOpenFloatingSearch');
        const btnTriggerMobile = document.getElementById('btnTriggerSearchMobile');
        const btnClose = document.getElementById('btnCloseFloatingSearch');
        const searchBar = document.getElementById('floatingSearchBar');
        const input = document.getElementById('floatingSearchInput');

        const openSearch = (e) => {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            console.log('[SEARCH] Abrindo busca mobile...');
            const sBar = document.getElementById('floatingSearchBar');
            const sInput = document.getElementById('floatingSearchInput');
            const sBtnOpen = document.getElementById('btnOpenFloatingSearch');

            if (sBar) {
                sBar.style.display = 'flex';
                sBar.style.visibility = 'visible';
                sBar.style.opacity = '1';
            }
            if (sBtnOpen) sBtnOpen.style.display = 'none';
            if (sInput) {
                setTimeout(() => sInput.focus(), 150);
            }
        };
        window.openSearch = openSearch;

        if (btnOpen) btnOpen.addEventListener('click', openSearch);
        if (btnTriggerMobile) btnTriggerMobile.addEventListener('click', openSearch);

        if (btnClose && searchBar && input) {
            btnClose.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                
                searchBar.style.display = 'none';
                btnOpen.style.display = 'flex';
                
                // Limpar busca ao fechar
                input.value = '';
                const results = document.getElementById('floatingSearchResults');
                if (results) {
                    results.hidden = true;
                    results.innerHTML = '';
                }
            });
        }
    });
</script>
