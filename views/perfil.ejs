<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/head', { title: 'Meu Perfil' }) %>
<link rel="stylesheet" href="/css/feed.css">
<body>
    <%- include('partials/navbar') %>

    <main id="main-content" style="background: var(--gray-50); min-height: 100vh; padding-top: 6rem;">
        <div class="container" style="max-width: 900px;">
            <div class="profile-layout-single">
                
                <!-- Main Profile Content -->
                <div class="main-profile-area">
                    <div class="profile-header animate-up" style="background: white; padding: 2.5rem; border-radius: 12px; border: 1px solid var(--gray-200); margin-bottom: 2rem; text-align: center; position: relative;">
                        <div class="profile-edit-actions" style="position: absolute; top: 1rem; right: 1rem;">
                            <button id="btn-edit-profile" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                                <i data-lucide="edit-3" aria-hidden="true" style="width: 14px; height: 14px;"></i>
                                Editar Perfil
                            </button>
                        </div>

                        <div class="user-avatar" style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1.25rem; overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--emerald-500); color: white; border: 4px solid white; box-shadow: var(--shadow-sm);">
                            <% if (user.profilePic) { %>
                                <img src="<%= user.profilePic %>" alt="Foto de <%= user.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                            <% } else { %>
                                <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&background=random" style="width: 100%; height: 100%; object-fit: cover;">
                            <% } %>
                        </div>
                        <h2 style="font-size: 1.75rem; margin-bottom: 0.25rem;"><%= user.name %></h2>
                        <p style="color: var(--gray-500); margin-bottom: 1rem; font-size: 0.9rem;"><%= user.email %></p>
                        <% if (user.bio) { %>
                            <p style="max-width: 550px; margin: 0 auto; color: var(--navy-800); line-height: 1.6; font-size: 0.95rem;"><%= user.bio %></p>
                        <% } else { %>
                            <p style="color: var(--gray-400); font-style: italic; font-size: 0.85rem;">Adicione uma biografia para as pessoas te conhecerem melhor.</p>
                        <% } %>
                    </div>

                    <!-- Medal Collection Section -->
                    <div class="sidebar-section animate-up" style="background: white; border-radius: 12px; border: 1px solid var(--gray-200); padding: 1.5rem; margin-bottom: 2rem;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                            <h3 style="font-size: 1.25rem; color: var(--navy-900); margin: 0;">Coleção de Medalhas</h3>
                            <span style="font-size: 0.8rem; color: var(--gray-500); background: var(--gray-50); padding: 0.25rem 0.75rem; border-radius: 20px;"><%= badges.length %> Conquistas</span>
                        </div>
                        
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 1.5rem;">
                            <% if (locals.badges && badges.length > 0) { %>
                                <% badges.forEach(function(badge) { %>
                                    <button class="badge-card" 
                                         onclick="showBadgeDetails('<%= badge.name %>', '<%= badge.desc %>', '<%= badge.img %>')"
                                         aria-label="Medalha: <%= badge.name %>. Clique para ver detalhes."
                                         style="background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%); border: 1px solid var(--gray-200); padding: 1.25rem 0.75rem; border-radius: 16px; text-align: center; cursor: pointer; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 140px; width: 100%; font-family: inherit;">
                                        <div style="width: 80px; height: 80px; margin-bottom: 0.75rem; border-radius: 50%; background: white; padding: 2px; box-shadow: 0 8px 20px rgba(0,0,0,0.06); display: flex; align-items: center; justify-content: center; overflow: hidden; pointer-events: none;">
                                            <img src="<%= badge.img %>" alt="" style="width: 100%; height: 100%; object-fit: contain; transition: transform 0.3s ease;">
                                        </div>
                                        <h4 style="margin: 0; font-size: 0.8rem; color: var(--navy-900); font-weight: 700; line-height: 1.2; pointer-events: none;"><%= badge.name %></h4>
                                    </button>
                                <% }); %>
                            <% } else { %>
                                <div style="grid-column: 1/-1; text-align: center; padding: 2rem; background: var(--gray-50); border-radius: 8px; border: 1px dashed var(--gray-200);">
                                    <p style="opacity: 0.6; font-size: 0.85rem; margin-bottom: 0.5rem;">Sua coleção está vazia.</p>
                                    <p style="font-size: 0.75rem; color: var(--emerald-600);">Publique projetos para ganhar sua primeira medalha!</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <style>
                        .badge-card:hover {
                            transform: translateY(-5px);
                            border-color: var(--emerald-200);
                            background: white;
                            box-shadow: var(--shadow-md);
                        }
                        .badge-card:hover .badge-tooltip {
                            opacity: 1;
                            visibility: visible;
                            transform: translateX(-50%) translateY(-5px);
                        }
                    </style>

                    <!-- My Agenda Section -->
                    <div class="sidebar-section animate-up" style="background: white; border-radius: 12px; border: 1px solid var(--gray-200); padding: 1.5rem; margin-bottom: 2rem;">
                        <h3 style="font-size: 1.25rem; margin-bottom: 1.5rem; color: var(--navy-900);">Minha Agenda</h3>
                        
                        <div class="events-timeline custom-scrollbar" style="max-height: 350px; overflow-y: auto; padding-right: 0.5rem;">
                            <% if (locals.joinedEvents && joinedEvents.length > 0) { %>
                                <% joinedEvents.forEach(function(event) { %>
                                    <div class="event-card" style="margin-bottom: 1rem; border: 1px solid var(--gray-50); background: var(--gray-50); border-radius: 8px; padding: 1rem; display: flex; justify-content: space-between; align-items: center;">
                                        <div style="display: flex; align-items: center; gap: 1.5rem;">
                                            <div class="event-date" style="background: white; padding: 0.5rem; border-radius: 6px; text-align: center; min-width: 60px;">
                                                <span class="day" style="display: block; font-size: 1.25rem; font-weight: 800; color: var(--navy-900);"><%= event.date.split('-')[2] %></span>
                                                <span class="month" style="display: block; font-size: 0.7rem; text-transform: uppercase; color: var(--emerald-600);"><%= event.date.split('-')[1] %></span>
                                            </div>
                                            <div class="event-details">
                                                <h4 style="margin: 0; font-size: 1.1rem;"><%= event.title %></h4>
                                                <div class="event-meta" style="font-size: 0.8rem; color: var(--gray-500); margin-top: 0.25rem;">
                                                    <span style="margin-right: 1rem;"><i data-lucide="map-pin" style="width: 12px; height: 12px;"></i> <%= event.location %></span>
                                                    <span><i data-lucide="clock" style="width: 12px; height: 12px;"></i> <%= event.time %></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div style="display: flex; gap: 0.75rem;">
                                            <a href="/evento?id=<%= event._id %>" class="btn btn-outline" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;">Ver</a>
                                            <form action="/evento/cancelar" method="POST" style="margin: 0;">
                                                <input type="hidden" name="eventId" value="<%= event._id %>">
                                                <button type="submit" class="btn" style="background: #fee2e2; color: #ef4444; padding: 0.5rem; width: 35px; height: 35px;" title="Sair do Evento">
                                                    <i data-lucide="x" style="width: 16px; height: 16px;"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div style="text-align: center; padding: 2rem; background: var(--gray-50); border-radius: 8px; border: 1px dashed var(--gray-200);">
                                    <p style="opacity: 0.6; font-size: 0.9rem;">Nenhum evento na sua agenda no momento.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- My Projects & Friends Grid -->
                    <div class="profile-secondary-grid">
                        <div class="animate-up profile-card-mini">
                            <h3 style="font-size: 1.1rem; margin-bottom: 1.25rem; color: var(--navy-900);">Meus Projetos</h3>
                            <div style="display: flex; flex-direction: column; gap: 1rem; height: 280px; overflow-y: auto; padding-right: 0.5rem;" class="custom-scrollbar">
                                <% if (locals.myProjects && myProjects.length > 0) { %>
                                    <% myProjects.forEach(function(project) { %>
                                        <a href="/projeto?id=<%= project.slug %>" style="display: flex; align-items: center; gap: 1rem; padding: 0.75rem; background: var(--gray-50); border-radius: 8px; text-decoration: none; transition: all 0.2s; overflow: hidden; flex-shrink: 0;">
                                            <img src="<%= project.image %>" style="width: 45px; height: 45px; object-fit: cover; border-radius: 6px; flex-shrink: 0;">
                                            <div style="flex: 1; min-width: 0;">
                                                <h4 style="color: var(--navy-900); margin: 0; font-size: 0.95rem; word-break: break-word; overflow-wrap: break-word;"><%= project.title %></h4>
                                                <span style="font-size: 0.75rem; color: var(--emerald-600);"><%= project.category %></span>
                                            </div>
                                        </a>
                                    <% }); %>
                                <% } else { %>
                                    <p style="color: var(--gray-400); font-size: 0.85rem; text-align: center;">Nenhum projeto criado.</p>
                                <% } %>
                            </div>
                        </div>

                        <div class="animate-up profile-card-mini">
                            <h3 style="font-size: 1.1rem; margin-bottom: 1.25rem; color: var(--navy-900);">Meus Eventos</h3>
                            <div style="display: flex; flex-direction: column; gap: 1rem; height: 280px; overflow-y: auto; padding-right: 0.5rem;" class="custom-scrollbar">
                                <% if (locals.myEvents && myEvents.length > 0) { %>
                                    <% myEvents.forEach(function(event) { %>
                                        <a href="/evento?id=<%= event._id %>" style="display: flex; align-items: center; gap: 1rem; padding: 0.75rem; background: var(--gray-50); border-radius: 8px; text-decoration: none; transition: all 0.2s; overflow: hidden; flex-shrink: 0;">
                                            <div style="width: 45px; height: 45px; background: white; border-radius: 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--gray-200);">
                                                <span style="font-size: 0.9rem; font-weight: 800; color: var(--navy-900); line-height: 1;"><%= event.date.split('-')[2] %></span>
                                                <span style="font-size: 0.6rem; text-transform: uppercase; color: var(--emerald-600);"><%= event.date.split('-')[1] %></span>
                                            </div>
                                            <div style="flex: 1; min-width: 0;">
                                                <h4 style="color: var(--navy-900); margin: 0; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= event.title %></h4>
                                                <span style="font-size: 0.75rem; color: var(--gray-500);"><%= event.location %></span>
                                            </div>
                                        </a>
                                    <% }); %>
                                <% } else { %>
                                    <p style="color: var(--gray-400); font-size: 0.85rem; text-align: center;">Nenhum evento criado.</p>
                                <% } %>
                            </div>
                        </div>

                        <div class="animate-up profile-card-mini">
                            <h3 style="font-size: 1.1rem; margin-bottom: 1.25rem; color: var(--navy-900);">Amigos</h3>
                            <div id="btn-view-friends" style="cursor: pointer; padding: 1.5rem; background: var(--gray-50); border-radius: 8px; text-align: center; border: 1px solid var(--gray-100); transition: all 0.2s; display: flex; flex-direction: column; align-items: center; gap: 0.75rem;">
                                <div style="width: 45px; height: 45px; background: var(--emerald-500); color: white; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                                    <i data-lucide="users" aria-hidden="true" style="width: 24px; height: 24px;"></i>
                                </div>
                                <div>
                                    <h4 style="color: var(--navy-900); margin: 0; font-size: 1rem;"><%= friendsList.length %> <%= friendsList.length === 1 ? 'Amigo' : 'Amigos' %></h4>
                                    <span style="font-size: 0.8rem; color: var(--emerald-600); font-weight: 600;">Ver todos</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- MODAL DE EDIÇÃO -->
    <div id="modal-edit-profile" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
        <div class="auth-card" style="position: relative; max-width: 500px; animation: fadeInUp 0.4s ease;">
            <button id="btn-close-modal" style="position: absolute; top: 1rem; right: 1rem; background: none; border: none; cursor: pointer; color: var(--gray-600);">
                <i data-lucide="x" aria-hidden="true"></i>
                <span class="sr-only">Fechar</span>
            </button>
            <div class="auth-header">
                <h2 id="edit-modal-title">Editar Perfil</h2>
                <p>Atualize sua foto e informações</p>
            </div>
            <form id="form-edit-profile" class="auth-form">
                <div class="form-group" style="text-align: center;">
                    <div id="profile-pic-preview" style="width: 100px; height: 100px; border-radius: 50%; background: var(--gray-100); margin: 0 auto 1rem; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 2px dashed var(--gray-300); cursor: pointer; position: relative;">
                        <% if (user.profilePic) { %>
                            <img src="<%= user.profilePic %>" style="width: 100%; height: 100%; object-fit: cover;">
                        <% } else { %>
                            <i data-lucide="camera" style="color: var(--gray-400);"></i>
                        <% } %>
                        <input type="file" id="input-profile-pic" accept="image/*" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;">
                    </div>
                </div>
                <div class="form-group">
                    <label for="bio">Sua Bio</label>
                    <textarea id="bio" name="bio" rows="4" style="padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid var(--gray-200); font-family: inherit; resize: none;" placeholder="Conte um pouco sobre você..."><%= user.bio || '' %></textarea>
                </div>
                <button type="submit" class="btn btn-primary" id="btn-save-profile">Salvar Alterações</button>
            </form>
        </div>
    </div>

    <!-- MODAL DE AMIGOS -->
    <div id="modal-amigos" role="dialog" aria-modal="true" aria-labelledby="friends-modal-title" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
        <div class="auth-card" style="position: relative; max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto;">
            <button id="btn-close-modal-amigos" style="position: absolute; top: 1rem; right: 1rem; background: none; border: none; cursor: pointer; color: var(--gray-600);">
                <i data-lucide="x" aria-hidden="true"></i>
                <span class="sr-only">Fechar</span>
            </button>
            <div class="auth-header">
                <h2 id="friends-modal-title">Seus Amigos</h2>
            </div>
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem;">
                <% if (locals.friendsList && friendsList.length > 0) { %>
                    <% friendsList.forEach(friend => { %>
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; background: var(--gray-50); border-radius: 8px; border: 1px solid var(--gray-100);">
                            <div style="display: flex; align-items: center; gap: 1rem;">
                                <img src="<%= friend.profilePic || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(friend.name) %>" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                                <h4 style="margin: 0; color: var(--navy-900); font-size: 0.95rem;"><%= friend.name %></h4>
                            </div>
                            <a href="/usuario/<%= friend._id %>" class="btn btn-outline" style="padding: 0.35rem 0.75rem; font-size: 0.75rem;">Ver Perfil</a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="text-align: center; opacity: 0.6; padding: 2rem;">Nenhum amigo ainda.</p>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('modal-edit-profile');
            const btnEdit = document.getElementById('btn-edit-profile');
            const btnClose = document.getElementById('btn-close-modal');
            const form = document.getElementById('form-edit-profile');
            const inputPic = document.getElementById('input-profile-pic');
            const picPreview = document.getElementById('profile-pic-preview');
            let base64Pic = '<%= user.profilePic || "" %>';

            if(btnEdit) btnEdit.addEventListener('click', () => modal.style.display = 'flex');
            if(btnClose) btnClose.addEventListener('click', () => modal.style.display = 'none');

            inputPic.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function(event) {
                    base64Pic = event.target.result;
                    picPreview.innerHTML = `<img src="${base64Pic}" style="width: 100%; height: 100%; object-fit: cover;">`;
                };
                reader.readAsDataURL(file);
            });

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btnSave = document.getElementById('btn-save-profile');
                btnSave.disabled = true;
                btnSave.innerText = 'Salvando...';
                try {
                    const response = await fetch('/perfil/update', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ bio: document.getElementById('bio').value, profilePic: base64Pic })
                    });
                    if (response.ok) location.reload();
                    else { alert('Erro ao salvar.'); btnSave.disabled = false; btnSave.innerText = 'Salvar'; }
                } catch (e) { console.error(e); }
            });

            const modalAmigos = document.getElementById('modal-amigos');
            const btnAmigos = document.getElementById('btn-view-friends');
            const btnCloseAmigos = document.getElementById('btn-close-modal-amigos');
            if(btnAmigos) btnAmigos.addEventListener('click', () => modalAmigos.style.display = 'flex');
            if(btnCloseAmigos) btnCloseAmigos.addEventListener('click', () => modalAmigos.style.display = 'none');

            // Lógica do Modal de Medalhas
            window.showBadgeDetails = function(name, desc, img) {
                const modal = document.getElementById('modal-badge');
                document.getElementById('badge-modal-title').innerText = name;
                document.getElementById('badge-modal-desc').innerText = desc;
                document.getElementById('badge-modal-img').src = img;
                modal.style.display = 'flex';
            };

            const modalBadge = document.getElementById('modal-badge');
            const btnCloseBadge = document.getElementById('btn-close-modal-badge');
            if(btnCloseBadge) btnCloseBadge.addEventListener('click', () => modalBadge.style.display = 'none');
            
            // Fechar modais ao clicar fora ou Esc
            window.addEventListener('click', (e) => {
                if (e.target === modal) modal.style.display = 'none';
                if (e.target === modalAmigos) modalAmigos.style.display = 'none';
                if (e.target === modalBadge) modalBadge.style.display = 'none';
            });

            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    if (modal) modal.style.display = 'none';
                    if (modalAmigos) modalAmigos.style.display = 'none';
                    if (modalBadge) modalBadge.style.display = 'none';
                }
            });
        });
    </script>

    <!-- MODAL DE MEDALHAS -->
    <div id="modal-badge" role="dialog" aria-modal="true" aria-labelledby="badge-modal-title" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 3000; align-items: center; justify-content: center; backdrop-filter: blur(8px);">
        <div class="auth-card" style="position: relative; max-width: 400px; width: 90%; text-align: center; padding: 3rem 2rem; border-radius: 24px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
            <button id="btn-close-modal-badge" style="position: absolute; top: 1.5rem; right: 1.5rem; background: var(--gray-100); border: none; cursor: pointer; color: var(--gray-600); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">
                <i data-lucide="x" aria-hidden="true"></i>
                <span class="sr-only">Fechar</span>
            </button>
            <div style="width: 120px; height: 120px; margin: 0 auto 2rem; border-radius: 50%; background: white; padding: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
                <img id="badge-modal-img" src="" style="width: 100%; height: 100%; object-fit: contain;">
            </div>
            <h2 id="badge-modal-title" style="font-size: 1.5rem; color: var(--navy-900); margin-bottom: 1rem; font-weight: 800;"></h2>
            <p id="badge-modal-desc" style="color: var(--gray-600); line-height: 1.6; font-size: 1rem; margin-bottom: 2rem;"></p>
            <button onclick="document.getElementById('modal-badge').style.display='none'" class="btn btn-primary" style="width: 100%; padding: 1rem;">Incrível!</button>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
