<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/head', { title: 'Perfil de ' + targetUser.name }) %>
<link rel="stylesheet" href="/css/feed.css">
<body>
    <%- include('partials/navbar') %>

    <main id="main-content" style="background: var(--gray-50); min-height: 100vh; padding-top: 6rem;">
        <div class="container" style="max-width: 900px;">
            <div class="profile-layout-single">
                
                <!-- Main Profile Content -->
                <div class="main-profile-area">
                    <div class="profile-header animate-up" style="background: white; padding: 2.5rem; border-radius: 12px; border: 1px solid var(--gray-200); margin-bottom: 2rem; text-align: center; position: relative;">
                        
                        <div class="user-avatar" style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1.25rem; overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--emerald-500); color: white; border: 4px solid white; box-shadow: var(--shadow-sm);">
                            <% if (targetUser.profilePic) { %>
                                <img src="<%= targetUser.profilePic %>" alt="Foto de <%= targetUser.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                            <% } else { %>
                                <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(targetUser.name) %>&background=random" style="width: 100%; height: 100%; object-fit: cover;">
                            <% } %>
                        </div>
                        <h2 style="font-size: 1.75rem; margin-bottom: 0.25rem;"><%= targetUser.name %></h2>
                        <p style="color: var(--gray-500); margin-bottom: 1.5rem; font-size: 0.9rem;">Membro desde <%= new Date(targetUser.createdAt).toLocaleDateString('pt-BR') %></p>
                        
                        <% if (targetUser.bio) { %>
                            <p style="max-width: 550px; margin: 0 auto 2rem; color: var(--navy-800); line-height: 1.6; font-size: 0.95rem;"><%= targetUser.bio %></p>
                        <% } %>

                        <div style="display: flex; justify-content: center; gap: 1rem;">
                            <% if (!locals.user) { %>
                                <a href="/login" class="btn btn-primary">Entrar para conectar</a>
                            <% } else { %>
                                <% if (friendshipStatus === 'friends') { %>
                                    <button class="btn btn-outline" style="cursor: default; border-color: var(--emerald-600); color: var(--emerald-600);">
                                        <i data-lucide="check" style="width: 18px; height: 18px; margin-right: 0.5rem;"></i> Amigos
                                    </button>
                                    <a href="/mensagens/<%= targetUser._id %>" class="btn btn-primary">
                                        <i data-lucide="message-circle" style="width: 18px; height: 18px; margin-right: 0.5rem;"></i> Mensagem
                                    </a>
                                <% } else if (friendshipStatus === 'pending') { %>
                                    <button class="btn btn-outline" disabled style="opacity: 0.7;">
                                        <i data-lucide="clock" style="width: 18px; height: 18px; margin-right: 0.5rem;"></i> Pendente
                                    </button>
                                <% } else { %>
                                    <form action="/amizade/request" method="POST" style="margin: 0;">
                                        <input type="hidden" name="targetId" value="<%= targetUser._id %>">
                                        <button type="submit" class="btn btn-primary">
                                            <i data-lucide="user-plus" style="width: 18px; height: 18px; margin-right: 0.5rem;"></i> Conectar
                                        </button>
                                    </form>
                                <% } %>
                            <% } %>
                        </div>
                    </div>

                    <!-- Medal Collection Section -->
                    <div class="animate-up" style="background: white; border-radius: 12px; border: 1px solid var(--gray-200); padding: 1.5rem; margin-bottom: 2rem;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                            <h3 style="font-size: 1.25rem; color: var(--navy-900); margin: 0;">Conquistas de <%= targetUser.name.split(' ')[0] %></h3>
                            <span style="font-size: 0.8rem; color: var(--gray-500); background: var(--gray-50); padding: 0.25rem 0.75rem; border-radius: 20px;"><%= badges.length %> Medalhas</span>
                        </div>
                        
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 1.5rem;">
                            <% if (locals.badges && badges.length > 0) { %>
                                <% badges.forEach(function(badge) { %>
                                    <button class="badge-card" 
                                         onclick="showBadgeDetails('<%= badge.name %>', '<%= badge.desc %>', '<%= badge.img %>')"
                                         aria-label="Medalha: <%= badge.name %>. Clique para ver detalhes."
                                         style="background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%); border: 1px solid var(--gray-200); padding: 1.25rem 0.75rem; border-radius: 16px; text-align: center; cursor: pointer; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 140px; width: 100%; font-family: inherit;">
                                        <div style="width: 80px; height: 80px; margin-bottom: 0.75rem; border-radius: 50%; background: white; padding: 2px; box-shadow: 0 8px 20px rgba(0,0,0,0.06); display: flex; align-items: center; justify-content: center; overflow: hidden; pointer-events: none;">
                                            <img src="<%= badge.img %>" alt="" style="width: 100%; height: 100%; object-fit: contain; transition: transform 0.3s ease;">
                                        </div>
                                        <h4 style="margin: 0; font-size: 0.8rem; color: var(--navy-900); font-weight: 700; line-height: 1.2; pointer-events: none;"><%= badge.name %></h4>
                                    </button>
                                <% }); %>
                            <% } else { %>
                                <div style="grid-column: 1/-1; text-align: center; padding: 2rem; background: var(--gray-50); border-radius: 8px; border: 1px dashed var(--gray-200);">
                                    <p style="opacity: 0.6; font-size: 0.85rem;">Ainda não conquistou medalhas.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <style>
                        .badge-card:hover {
                            transform: translateY(-5px);
                            border-color: var(--emerald-200);
                            background: white;
                            box-shadow: var(--shadow-md);
                        }
                        .badge-card:hover .badge-tooltip {
                            opacity: 1;
                            visibility: visible;
                            transform: translateX(-50%) translateY(-5px);
                        }
                    </style>

                    <!-- History / Projects -->
                    <div class="animate-up" style="background: white; border-radius: 12px; border: 1px solid var(--gray-200); padding: 1.5rem; margin-bottom: 2rem;">
                        <h3 style="font-size: 1.25rem; margin-bottom: 1.5rem; color: var(--navy-900);">Projetos de <%= targetUser.name.split(' ')[0] %></h3>
                        
                        <div class="projects-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem;">
                            <% if (locals.myProjects && myProjects.length > 0) { %>
                                <% myProjects.forEach(function(project) { %>
                                    <div class="project-card" style="border: 1px solid var(--gray-100); border-radius: 8px; overflow: hidden; cursor: pointer;" onclick="location.href='/projeto?id=<%= project.slug %>'">
                                        <div style="height: 140px; background-image: url('<%= project.image %>'); background-size: cover; background-position: center;"></div>
                                        <div style="padding: 1rem;">
                                            <h4 style="margin: 0; font-size: 1rem;"><%= project.title %></h4>
                                            <span style="font-size: 0.75rem; color: var(--emerald-600);"><%= project.category %></span>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p style="grid-column: 1/-1; text-align: center; padding: 2rem; opacity: 0.5;">Ainda não criou projetos.</p>
                            <% } %>
                        </div>
                    </div>

                    <!-- Participating Events -->
                    <div class="animate-up" style="background: white; border-radius: 12px; border: 1px solid var(--gray-200); padding: 1.5rem;">
                        <h3 style="font-size: 1.25rem; margin-bottom: 1.5rem; color: var(--navy-900);">Agenda de <%= targetUser.name.split(' ')[0] %></h3>
                        <div class="events-timeline">
                            <% if (locals.joinedEvents && joinedEvents.length > 0) { %>
                                <% joinedEvents.forEach(function(event) { %>
                                    <div class="event-card" style="margin-bottom: 1rem; border-left: 4px solid var(--emerald-500); background: var(--gray-50); padding: 1rem; border-radius: 0 8px 8px 0; display: flex; justify-content: space-between; align-items: center;">
                                        <div>
                                            <h4 style="margin: 0; font-size: 1rem;"><%= event.title %></h4>
                                            <p style="font-size: 0.8rem; color: var(--gray-500); margin-top: 0.25rem;">
                                                <%= new Date(event.date).toLocaleDateString('pt-BR') %> • <%= event.time %>h
                                            </p>
                                        </div>
                                        <a href="/evento?id=<%= event._id %>" class="btn btn-outline" style="padding: 0.3rem 0.75rem; font-size: 0.75rem;">Ver</a>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p style="text-align: center; opacity: 0.5; padding: 1rem;">Nenhum evento registrado.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- MODAL DE MEDALHAS -->
    <div id="modal-badge" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 3000; align-items: center; justify-content: center; backdrop-filter: blur(8px);">
        <div class="auth-card" style="position: relative; max-width: 400px; width: 90%; text-align: center; padding: 3rem 2rem; border-radius: 24px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
            <button id="btn-close-modal-badge" style="position: absolute; top: 1.5rem; right: 1.5rem; background: var(--gray-100); border: none; cursor: pointer; color: var(--gray-600); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">
                <i data-lucide="x" style="width: 18px; height: 18px;"></i>
            </button>
            <div style="width: 120px; height: 120px; margin: 0 auto 2rem; border-radius: 50%; background: white; padding: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
                <img id="badge-modal-img" src="" style="width: 100%; height: 100%; object-fit: contain;">
            </div>
            <h2 id="badge-modal-title" style="font-size: 1.5rem; color: var(--navy-900); margin-bottom: 1rem; font-weight: 800;"></h2>
            <p id="badge-modal-desc" style="color: var(--gray-600); line-height: 1.6; font-size: 1rem; margin-bottom: 2rem;"></p>
            <button onclick="document.getElementById('modal-badge').style.display='none'" class="btn btn-primary" style="width: 100%; padding: 1rem;">Incrível!</button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            window.showBadgeDetails = function(name, desc, img) {
                const modal = document.getElementById('modal-badge');
                document.getElementById('badge-modal-title').innerText = name;
                document.getElementById('badge-modal-desc').innerText = desc;
                document.getElementById('badge-modal-img').src = img;
                modal.style.display = 'flex';
            };

            const modalBadge = document.getElementById('modal-badge');
            const btnCloseBadge = document.getElementById('btn-close-modal-badge');
            if(btnCloseBadge) btnCloseBadge.addEventListener('click', () => modalBadge.style.display = 'none');
            
            window.addEventListener('click', (e) => {
                if (e.target === modalBadge) modalBadge.style.display = 'none';
            });

            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    if (modalBadge) modalBadge.style.display = 'none';
                }
            });
        });
    </script>

    <%- include('partials/footer') %>
</body>
</html>
